*
!.vercelignore
!apps
!apps/web
!apps/web/**
!apps/private-agent-worker
!apps/private-agent-worker/**
!packages
!packages/perps-core
!packages/perps-core/**
!packages/execution-core
!packages/execution-core/**
!crates
!crates/said-shielded-pool-circuits
!crates/said-shielded-pool-circuits/artifacts
!crates/said-shielded-pool-circuits/artifacts/**
!deploy
!deploy/evidence
!deploy/evidence/hyperliquid-mainnet-proof-2026-08-23.json
!deploy/evidence/CARRY_MAINNET_PROOF_RUNBOOK.md

# Vercel's linked project root is apps/web. When the CLI applies this
# ignore file relative to that root, the repo-root exceptions above do
# not match. Keep the web app source included in both contexts.
!package.json
!package-lock.json
!vercel.json
!next.config.ts
!postcss.config.mjs
!tsconfig.json
!next-env.d.ts
!eslint.config.mjs
!vitest.config.ts
!src
!src/**
!public
!public/**
!scripts
!scripts/**

# Local environment files must never enter a Vercel source bundle. Keep the
# checked-in template available in either repo-root or apps/web-root uploads.
.env
.env.*
!.env.example
apps/web/.env
apps/web/.env.*
!apps/web/.env.example

apps/web/.next
apps/web/.next/**
apps/web/node_modules
apps/web/node_modules/**
apps/web/coverage
apps/web/.turbo
apps/web/out
apps/web/dist
apps/web/build
apps/web/tsconfig.tsbuildinfo
.next
node_modules
coverage
.turbo
out
dist
build
