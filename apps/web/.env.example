# Exact browser origins registered on the Google OAuth web client. Register
# each origin as an Authorized JavaScript origin and append
# /api/auth/session/google/callback as its Authorized redirect URI. Dynamic
# Vercel Preview hosts stay excluded so they do not expose a broken button.
NEXT_PUBLIC_GOOGLE_AUTH_ALLOWED_ORIGINS=https://ghola.xyz

# Phoenix live market chart (Private Mode > Phoenix venue).
# Public market-data feed for the from-scratch live SOL chart. Read-only; no keys.
NEXT_PUBLIC_PHOENIX_API_URL=https://perp-api.phoenix.trade
# Mainnet RPC that supports wss accountSubscribe (Helius/Triton). Used for the SDK's
# on-chain bootstrap/fallback. Do NOT reuse NEXT_PUBLIC_SOLANA_RPC (devnet) here.
NEXT_PUBLIC_PHOENIX_RPC_WS=

