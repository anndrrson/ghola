NEXT_PUBLIC_API_URL=http://localhost:8080/v1
NEXT_PUBLIC_ORNI_API_URL=http://localhost:8081/api
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# Required for investor access login and live-release validation.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GHOLA_EXECUTION_API_URL=https://ghola-api.onrender.com
GHOLA_EXECUTION_BRIDGE_AUTH_TOKEN=
GHOLA_EXECUTION_BRIDGE_AUTH_ID=
GHOLA_EXECUTION_BRIDGE_SIGNING_SECRET=
GHOLA_INVESTOR_WEB_ORIGIN=https://ghola.xyz
# Server-only; must match thumper-cloud and must never use NEXT_PUBLIC_ prefix.
GHOLA_INVESTOR_CANARY_SECRET=
# Distinct 32+ character credentials; reset is used only for exact-version killed -> disabled recovery.
GHOLA_LIVE_TRADING_CONTROL_TOKEN=
GHOLA_LIVE_TRADING_RESET_TOKEN=
# Dedicated 32+ character bearer for POST-only scheduled worker routes.
CRON_SECRET=
# Local development only. Production live trading requires `postgres` plus a URL.
GHOLA_PRIVATE_ACCOUNT_STORE=memory
GHOLA_PRIVATE_ACCOUNT_DATABASE_URL=
# Investor live release only: explicit stable public HTTPS origin; aliases and local URLs are rejected.
GHOLA_PRIVATE_AGENT_EXECUTION_URL=
# Ordinary wake may inspect/start the existing CVM. Only an explicitly approved
# operator provision window may temporarily set this true.
GHOLA_PRIVATE_AGENT_PROVISIONING_MUTATIONS_ENABLED=false
# Investor-live releases keep this false until durable global BYO flatness exists.
GHOLA_PRIVATE_AGENT_IDLE_SHUTDOWN=false
# Investor live release only: exact source-bound tag; pin its sha256 digest separately.
GHOLA_PRIVATE_AGENT_WORKER_IMAGE=
GHOLA_PRIVATE_AGENT_WORKER_IMAGE_DIGEST=
