{
  "name": "ghola-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local-safe.mjs",
    "build": "next build && node scripts/build-inline-csp.mjs && node scripts/check-auth-client-bundle.mjs && node scripts/build-sri-manifest.mjs",
    "build:no-sri": "next build && node scripts/check-auth-client-bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:investor:canary": "node --test scripts/investor-canary-acceptance.test.mjs scripts/investor-canary-docs.test.mjs scripts/investor-canary-live-verifier.test.mjs scripts/issue-investor-access-pass.test.mjs",
    "issue:investor:pass": "node scripts/issue-investor-access-pass.mjs",
    "security:check": "npm test && npm run lint",
    "test:auth": "vitest run src/lib/thumper-api.test.ts src/app/api/auth/session/email/signin/route.test.ts src/app/api/auth/session/email/signup/route.test.ts",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "smoke:trader-local": "node scripts/ghola-trader-local-e2e.mjs",
    "smoke:trader-staging": "GHOLA_TRADER_E2E_STATE_STORE=postgres node scripts/ghola-trader-local-e2e.mjs",
    "smoke:trader-testnet-funded": "node scripts/ghola-trader-funded-testnet-e2e.mjs",
    "smoke:auction-local": "node scripts/ghola-auction-local-e2e.mjs",
    "smoke:auction-devnet": "GHOLA_AUCTION_SMOKE_CLUSTER=devnet node scripts/ghola-auction-local-e2e.mjs",
    "verify:live:all": "node scripts/verify-live-all.mjs",
    "verify:prod:trading": "node scripts/verify-prod-trading.mjs",
    "verify:prod:hyperliquid": "node scripts/verify-prod-hyperliquid.mjs",
    "verify:prod:hyperliquid:live": "GHOLA_VERIFY_LIVE_SUBMIT=true node scripts/verify-prod-hyperliquid.mjs",
    "verify:investor:canary": "node scripts/investor-canary-acceptance.mjs",
    "verify:investor:canary:live": "node scripts/investor-canary-live-verifier.mjs",
    "certify:charts": "vitest run src/lib/hyperliquid-market-data.test.ts src/lib/hyperliquid-live-market.test.ts src/lib/market-component-clock.test.ts src/lib/terminal-certified-market-signals.test.ts src/lib/unified-live-market.test.ts src/lib/ghola-chart-engine.test.ts src/lib/ghola-market-chart.test.ts && node scripts/certify-hyperliquid-charts.mjs",
    "certify:terminal:local": "node scripts/certify-terminal-local.mjs",
    "certify:terminal:local:quick": "node scripts/certify-terminal-local.mjs --quick",
    "guard:auth-bundle": "node scripts/check-auth-client-bundle.mjs"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "protobufjs": "8.7.2",
    "sharp": "0.35.3",
    "undici": "6.28.0",
    "vite": "8.0.16",
    "ws": "8.21.0",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@ellipsis-labs/rise": "^0.4.19",
    "@huggingface/transformers": "^4.2.0",
    "@mlc-ai/web-llm": "^0.2.83",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@phala/cloud": "^0.2.9",
    "@provablehq/sdk": "^0.10.5",
    "@sentry/nextjs": "^10.65.0",
    "@solana/wallet-standard-features": "1.4.0",
    "@solana/wallet-standard-util": "1.1.3",
    "@solana/web3.js": "^1.98.4",
    "@turnkey/api-key-stamper": "^0.6.2",
    "@turnkey/sdk-browser": "^5.15.1",
    "@turnkey/sdk-server": "^5.1.0",
    "@turnkey/solana": "^1.1.25",
    "@types/three": "^0.184.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.4.0",
    "@vercel/speed-insights": "^2.0.0",
    "@wallet-standard/app": "1.1.1",
    "bs58": "^6.0.0",
    "dompurify": "^3.4.13",
    "hpke-js": "^1.8.0",
    "jszip": "^3.10.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.577.0",
    "next": "^16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "viem": "2.50.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  }
}
