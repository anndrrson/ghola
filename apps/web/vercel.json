{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "installCommand": "ONNXRUNTIME_NODE_INSTALL=skip corepack pnpm@10.34.5 install --frozen-lockfile",
  "crons": [
    {
      "path": "/v1/private-account/funding/batch/cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/private-agent/idle",
      "schedule": "0 1 * * *"
    }
  ]
}
