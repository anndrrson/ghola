# shutdown whenever paid activity extends the lease. The daily Hobby-compatible
# cron is disaster-recovery only; it is not the primary idle timer.
GHOLA_PRIVATE_AGENT_IDLE_SHUTDOWN=true
GHOLA_PRIVATE_AGENT_IDLE_AFTER_MINUTES=30
