<?xml version="1.0" encoding="utf-8"?>
<!--
  Unselected size preset: the surface version of the "hardware key" —
  2dp near-black lip, 1dp muted rim-light, top-lit dark gradient face
  with a hairline border. Same family as @drawable/btn_primary, in
  surface tones.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ghola_accent_wash">
    <item>
        <selector>

            <item android:state_pressed="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="12dp" />
                            <solid android:color="#04060a" />
                        </shape>
                    </item>
                    <item android:bottom="1dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="12dp" />
                            <gradient
                                android:angle="270"
                                android:startColor="#232a3a"
                                android:endColor="#161b26" />
                            <stroke android:width="1dp" android:color="#33405c" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <item>
                <layer-list>
                    <!-- Bottom lip -->
                    <item>
                        <shape android:shape="rectangle">
                            <corners android:radius="12dp" />
                            <solid android:color="#04060a" />
                        </shape>
                    </item>
                    <!-- Top rim-light -->
                    <item android:bottom="2dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="12dp" />
                            <solid android:color="#2c3750" />
                        </shape>
                    </item>
                    <!-- Face -->
                    <item android:bottom="2dp" android:top="1dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="12dp" />
                            <gradient
                                android:angle="270"
                                android:startColor="#1c2231"
                                android:endColor="#12161f" />
                            <stroke android:width="1dp" android:color="#29344c" />
                        </shape>
                    </item>
                </layer-list>
            </item>

        </selector>
    </item>
</ripple>
