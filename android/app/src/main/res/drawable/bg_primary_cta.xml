<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary call-to-action used by container-style CTAs (Home hero,
  onboarding). Matches @drawable/btn_primary's default state: ambient
  halo, deep lip, top rim-light, three-stop gradient face. Ink is
  near-black for AA.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#26ffffff">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#2e3da8ff" />
                </shape>
            </item>
            <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#124a78" />
                </shape>
            </item>
            <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#b5e3ff" />
                </shape>
            </item>
            <item android:left="2dp" android:right="2dp" android:top="3dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#8ed0ff"
                        android:endColor="#2273cc" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
